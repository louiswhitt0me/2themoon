// Cloudflare Workers config: serves this folder as static assets at app.the0gclub.com.
// Deploy with `npx wrangler deploy`. Files in .assetsignore are not uploaded.
{
  "name": "the0gclub-app",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "." },
  "routes": [
    { "pattern": "app.the0gclub.com", "custom_domain": true }
  ]
}
